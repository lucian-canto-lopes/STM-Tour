# Porta publicada pelo Flask no seu computador
FLASK_PORT=5000

# Altere em produção. No Docker, o host do Mongo é o nome do serviço: mongo.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=troque-esta-senha
MONGO_INITDB_DATABASE=stm_tour
MONGO_URI=mongodb://admin:troque-esta-senha@mongo:27017/stm_tour?authSource=admin
# Usado quando a URL acima não inclui o nome do banco (por exemplo, no Railway).
MONGO_DB_NAME=stm_tour

# Chave aleatória longa e estável para as sessões.
SECRET_KEY=
# Use true quando servido por HTTPS.
SESSION_COOKIE_SECURE=false

# Opcionais: criam a conta inicial no startup, sem alterar contas existentes.
# Configure ambos no Railway e remova após a criação. Senha: mínimo 12 caracteres.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
